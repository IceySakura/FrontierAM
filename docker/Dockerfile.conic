FROM python:3.12.14-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 BLIS_NUM_THREADS=1 RAYON_NUM_THREADS=1 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp PIP_NO_INDEX=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gfortran cmake ninja-build pkg-config rustc cargo \
    libblas-dev liblapack-dev libseccomp2 bash coreutils procps util-linux \
    git curl ca-certificates ripgrep unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*
RUN PIP_NO_INDEX=0 python -m pip install --no-cache-dir numpy==2.3.5 scipy==1.16.3 psutil==7.1.3
RUN mkdir -p /workspace/submission /submission /input /output /audit /opt/evaluator /home/agent \
    && chown -R 1000:1000 /workspace /submission /output /home/agent && chmod 700 /audit
WORKDIR /workspace
ENTRYPOINT []
CMD ["sleep", "infinity"]
