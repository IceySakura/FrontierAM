# amd64 reconstruction of local/four-angle-wen-dev:vnext (images/runtime-images.tar in the vNext 1.3.0-dev maintenance
# package, image sha256:80b3867f...). Its history is the v1.2 solver recipe: official python:3.11.15-slim-bookworm, the
# image's own requirements.lock (byte-identical to v1.2's), user worker (1000), single-thread library defaults, then the
# vNext workspace (problem.md, public-dev/check.py, public-dev/wen5). torch comes from the CPU wheel index (the default
# PyPI amd64 wheel bundles CUDA). The vendored Codex layers are the author's agent tooling, not the solver environment.
FROM python:3.11.15-slim-bookworm
COPY requirements.lock /opt/bo/requirements.lock
RUN python3 -m pip install --no-cache-dir --index-url https://mirrors.tencent.com/pypi/simple/ \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        "torch==2.2.2+cpu" $(grep -v '^torch==' /opt/bo/requirements.lock) \
    && python3 -m pip check
RUN groupadd --gid 1000 worker && useradd --create-home --uid 1000 --gid 1000 worker \
    && rm -rf /opt/bo && mkdir -p /workspace/submission /workspace/public-dev && chown worker:worker /workspace /workspace/submission
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 BLIS_NUM_THREADS=1 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/worker
COPY problem.md /workspace/problem.md
COPY public-dev /workspace/public-dev
RUN chmod -R a=rX /workspace/problem.md /workspace/public-dev
WORKDIR /workspace
