# amd64 reconstruction of local/galaxy-gravity-cpu:b2: the package's own Dockerfile on its base local/trajectory-runtime:b1,
# which ships (ARM64) in the trajectory-covariance maintainer package and is rebuilt for amd64 as
# frontieram-trajectory-covariance:amd64-b1 (CPython 3.11.15, NumPy 1.26.4, SciPy 1.12.0, R 4.2.2, gcc/g++ 12).
# The original uses `ln -s`; -sf keeps the layer idempotent.
ARG BASE=frontieram-trajectory-covariance:amd64-b1
FROM ${BASE}
USER root
RUN rm -rf /workspace/public-dev && ln -sf /usr/local/bin/python3 /usr/bin/python3
COPY public-dev/ /workspace/public-dev/
COPY problem.md /workspace/problem.md
RUN chmod -R a=rX /workspace/public-dev /workspace/problem.md
WORKDIR /workspace
