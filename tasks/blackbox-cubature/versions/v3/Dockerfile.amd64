# blackbox-cubature v3 task image: the v2 image's numerical environment unchanged (python:3.11-slim-bookworm, numpy
# 2.1.3, SciPy 1.17.1, QMCPy 2.4, a C toolchain; versions/v2/Dockerfile.amd64) with the v2 workspace removed. The
# development workspace comes from the sealed public.tar (scripts/seal/seal_cubature_v3.py); grading mounts the
# submission read-only at /workspace/submission. Builds offline from the local v2 image.
FROM frontieram-blackbox-cubature:amd64-v5-r1
USER root
RUN rm -rf /workspace && mkdir -p /workspace/submission && chown worker:worker /workspace /workspace/submission
WORKDIR /workspace
