# amd64 reconstruction of local/galaxy-gravity-cpu:b2. The original is built FROM local/trajectory-runtime:b1, which is
# not shipped; its documented toolchain (Debian bookworm, CPython 3.12.14 under /usr/local, NumPy 2.3.5, gcc) matches
# the conic success-v2 image from the same author, used here as the base. The task layer is the original Dockerfile.
ARG BASE=frontieram-conic:success-v2-port-v1
FROM ${BASE}
USER root
RUN rm -rf /workspace/public-dev && ln -sf /usr/local/bin/python3 /usr/bin/python3
COPY public-dev/ /workspace/public-dev/
COPY problem.md /workspace/problem.md
RUN chmod -R a=rX /workspace/public-dev /workspace/problem.md
WORKDIR /workspace
