# amd64 stand-in for local/trajectory-runtime:b1 (not shipped). The task promises Python 3, NumPy, SciPy, R and C/C++;
# the conic success-v2 image supplies CPython 3.12.14, NumPy 2.3.5, SciPy 1.16.3 and gcc/g++ 12, and R is added from
# Debian bookworm.
ARG BASE=frontieram-conic:success-v2-port-v1
FROM ${BASE}
USER root
RUN sed -i 's#http://deb.debian.org#https://mirrors.tencent.com#g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    apt-get update && apt-get install -y --no-install-recommends r-base-core && rm -rf /var/lib/apt/lists/*
RUN rm -rf /workspace/public-dev && ln -sf /usr/local/bin/python3 /usr/bin/python3
COPY public-dev/ /workspace/public-dev/
COPY problem.md /workspace/problem.md
RUN chmod -R a=rX /workspace/public-dev /workspace/problem.md
WORKDIR /workspace
