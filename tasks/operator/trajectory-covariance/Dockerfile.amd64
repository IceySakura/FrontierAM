# amd64 rebuild of local/trajectory-runtime:b1 following the maintainer package's own
# harbor/mcmc-long-run-covariance/public/Dockerfile, on the amd64 reconstruction of its base
# songberg-reproduction:mcmcse-1.5-0 (tasks/operator/_images/songberg-reproduction). problem.md and trajectory-dev.zip
# are byte-identical in the public and maintainer packages. The original PATH also lists /opt/public-codex (the author's
# agent tooling, not rebuilt).
ARG BASE=frontieram-songberg-reproduction:amd64-mcmcse-1.5-0
FROM ${BASE} AS scrub
USER root
RUN rm -rf /tmp/* /opt/bo /opt/songberg-* /usr/local/lib/R/site-library/momentLS /workspace /root/.cache /var/cache/apt/archives/* && mkdir -p /workspace/public-dev /workspace/submission && chown 1000:1000 /workspace/submission
COPY problem.md /workspace/problem.md
COPY public-dev/trajectory-dev.zip /workspace/public-dev/trajectory-dev.zip
RUN cd /workspace/public-dev && python3 -m zipfile -e trajectory-dev.zip . && chmod -R a=rX /workspace/public-dev /workspace/problem.md
FROM scratch
COPY --from=scrub / /
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin HOME=/home/worker LANG=C.UTF-8 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 BLIS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
CMD ["/bin/bash"]
