#!/usr/bin/env bash
# Copy this file to ignored benchmark.env, fill the values, then run:
#
#   cp nexus/extensions/tasks/stem_mas/benchmark/runners/benchmark.env.example \
#     nexus/extensions/tasks/stem_mas/benchmark/runners/benchmark.env
#   bash nexus/extensions/tasks/stem_mas/benchmark/runners/run_batch_template.sh
#
# or submit to Ray:
#
#   bash nexus/extensions/tasks/stem_mas/benchmark/runners/submit_platform_template.sh
#
# Do not put real tokens in this example file.

# ---------- runner ----------
# Choose exactly one experiment config. Keep the established HLE config as the
# neutral default; select a math config explicitly for formal-math runs.
export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/hle/codex_v7.yaml

# HLE examples:
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/hle/codex_v7.yaml
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/hle/claude_code_v7.yaml
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/hle/main_agent_api.yaml
# main_agent_api reads pages with open+find; main_agent_visit reads them in one
# summarised step. Both need CODE_INTERPRETER=jupyter.
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/hle/main_agent_visit.yaml

# Math examples:
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/math/deepseek_v4_flash/no_agent.yaml
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/math/deepseek_v4_flash/codex.yaml
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/math/deepseek_v4_flash/codex_lean.yaml
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/math/a20b_high_260609_v5_step320_192k/no_agent.yaml
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/math/a20b_high_260609_v5_step320_192k/codex.yaml
# export CONFIG=nexus/extensions/tasks/stem_mas/benchmark/eval/config/math/a20b_high_260609_v5_step320_192k/codex_lean.yaml

# Dataset is a run parameter. Leave path empty to use the adapter's default
# public/official source. Supported math names:
#   minif2f putnam672 putnam-2025 fatem fateh fatex
export STEM_MAS_DATASET_NAME=hle_200
export STEM_MAS_DATASET_PATH=REPLACE_ME_HLE_200_PARQUET_OR_JSONL
# Optional materialization limit for smoke tests.
# export STEM_MAS_DATASET_LIMIT=3

# HLE example:
# export STEM_MAS_DATASET_NAME=hle_200
# export STEM_MAS_DATASET_PATH=REPLACE_ME_HLE_200_PARQUET_OR_JSONL

export RUN_DIR=outputs/stem_mas_${STEM_MAS_DATASET_NAME}
# Keep the neutral HLE starting point here. Override this per run after checking
# model, Codex sub-agent, MCP, and runtime-container capacity.
export MAX_CONCURRENT=20
# Optional: split one batch into N local shard worker processes. This uses the
# built-in Nexus sharded batch runner and is preferred over launching duplicate
# full-dataset jobs when you need to saturate a single dataset/method.
# export WORKER_PROCESSES=5
export RETRY_FAILED=0
# Optional batch-runner per-item timeout. Formal math runs can have long tails;
# use 7200 for full formal runs when you want to avoid repeated short retries.
# export TIMEOUT_PER_RUN=7200
export DATABASE="${RUN_DIR}/stem_mas.db"
export EXPORT_PATH="${RUN_DIR}/stem_mas.jsonl"
export CODE_INTERPRETER=none
# Math formal-proof runs should use the Lean4 verifier route, not an LLM judge.
# export STEM_MAS_EVALUATOR_TYPE=none
# export STEM_MAS_EVALUATOR_TYPE=general

# Optional local validation / submit dry-runs.
# export DRY_RUN_CONFIG=1
# export DRY_RUN_SUBMIT=1
# export RAY_NO_WAIT=1

# ---------- Ray platform submit ----------
export RAY_ADDRESS=REPLACE_ME_RAY_ADDRESS
export JOB_ID=stem-mas-${STEM_MAS_DATASET_NAME}

# ---------- proxy / package index ----------
# export http_proxy=http://REPLACE_ME_PROXY:3128
# export https_proxy=http://REPLACE_ME_PROXY:3128
# export HTTP_PROXY=http://REPLACE_ME_PROXY:3128
# export HTTPS_PROXY=http://REPLACE_ME_PROXY:3128
# export NO_PROXY=localhost,127.0.0.1
# export no_proxy="${NO_PROXY}"
# export UV_DEFAULT_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
# Fresh Ray working directories need module-declared host dependencies.
export NEXUS_AUTO_INSTALL=1
# Set this for no-agent/local LLM runs against internal model-eval endpoints;
# otherwise a sourced host proxy can route model requests through hy-proxy.
# export STEM_MAS_CLEAR_MODEL_API_PROXY=1

# ---------- search tool ----------
export SEARCH_USER=REPLACE_ME_SEARCH_USER
export SEARCH_API_KEY=REPLACE_ME_SEARCH_API_KEY
# export SEARCH_STATEFUL_JINA_PROVIDER=aws_jina

# ---------- Gongfeng runtime ----------
export GONGFENG_API_BASE_URL=REPLACE_ME_GONGFENG_API_BASE_URL
export GONGFENG_RUNTIME_TOKEN=REPLACE_ME_GONGFENG_RUNTIME_TOKEN
export STEM_MAS_IMAGE=mirrors.tencent.com/hunyuan_yanguan/nexus-runtime:latest
export STEM_MAS_RUNTIME_IMAGE=mirrors.tencent.com/hunyuan_yanguan/nexus-runtime:latest

# ---------- generation model ----------
export SCIENCE_API_KEY=REPLACE_ME_SCIENCE_API_KEY
export SCIENCE_BASE_URL=REPLACE_ME_SCIENCE_BASE_URL
# Model-specific defaults live in the selected config. Do not export one
# model's values globally, because they would override A20B/DeepSeek/HLE config
# defaults alike. Uncomment only the overrides needed by the selected config.

# DeepSeek Flash overrides:
# export GENERATION_MODEL=openai/api_deepseek_deepseek-v4-flash
# export GENERATION_MAX_TOKENS=131072
# export GENERATION_MAX_RETRIES=25
# export GENERATION_TIMEOUT=7200
# export GENERATION_REASONING_EFFORT=max
# Historical search_stateful single-run alias was deepseek/deepseek-v4-flash.
# Use it only if the current platform has a healthy deepseek-v4-flash model
# group and SCIENCE_API_KEY includes provider=deepseek routing.
# export SCIENCE_API_KEY="${DEEPSEEK_APP_ID}:${DEEPSEEK_APP_KEY}?provider=deepseek&timeout=${GENERATION_TIMEOUT}"
# export GENERATION_MODEL=deepseek/deepseek-v4-flash

# ---------- A20B Taiji generation, if using config/math/a20b_high_260609_v5_step320_192k/* ----------
# export GENERATION_MODEL=A20B-High-260609-V5-step320-192K
# export GENERATION_TAIJI_POLARIS_SERVICE=A20B-High-260609-V5-step320-192K_AIDE
# export GENERATION_MAX_TOKENS=131072
# export GENERATION_MAX_RETRIES=25
# export GENERATION_TIMEOUT=7200
# export GENERATION_REASONING_EFFORT=high

# ---------- Taiji judge ----------
export JUDGE_MODEL=REPLACE_ME_JUDGE_MODEL
export TAIJI_NS=Production
export TAIJI_POLARIS_SERVICE=REPLACE_ME_TAIJI_POLARIS_SERVICE
export TAIJI_AUTH='Bearer REPLACE_ME_TAIJI_TOKEN'
export TAIJI_WSID=10103
export TAIJI_URL_PATTERN=v1
# export TAIJI_TIMEOUT=36000
# export JUDGE_MAX_RETRIES=50

# ---------- Lean MCP, if using config/math/*/codex_lean.yaml ----------
# Codex uses an npx mcp-remote stdio bridge in its config.
# export LEAN_LSP_MCP_URL=http://lean-lsp-mcp-v0d27d0.production.polaris:8080/mcp
# export LEAN_LSP_MCP_TIMEOUT_S=300
# export LEAN_LSP_MCP_TOOL_TIMEOUT_S=7200

# ---------- Lean4 verifier, if using formal math configs ----------
export LEAN4_VERIFIER_URL=http://lean4-verifier-v0d2d0.production.polaris:8080
export LEAN4_VERIFIER_TIMEOUT_SECONDS=300
export LEAN4_VERIFIER_FORBID_SORRY=true

# ---------- Reward System judge, if evaluator_type=reward_system ----------
# export NEXUS_REWARD_SYSTEM_TOKEN=REPLACE_ME_REWARD_SYSTEM_TOKEN
# export NEXUS_REWARD_SYSTEM_EXP_ID=stem_mas_math
# export NEXUS_REWARD_SYSTEM_ROUTER_ID=ScienceOss--10
# export NEXUS_REWARD_SYSTEM_CI_TEST=false
export NEXUS_REWARD_SYSTEM_EXTRA_JSON='{"answer_pattern":"(.*)","answer_type":"T1","default_truncate_score":0,"process_format_error":1,"process_truncate":false,"short_answer_pattern":"(.*)"}'

# ---------- Codex agent config, if using Codex config ----------
export CODEX_VERSION=0.131.0-alpha.22
# For exact legacy/default-policy reproduction only, compare separate runs with:
# export CODEX_VERSION=0.114.0
# export CODEX_VERSION=latest
# export CODEX_MODEL=gpt-5
# export CODEX_NPM_REGISTRY=http://mirrors.tencent.com/npm/
